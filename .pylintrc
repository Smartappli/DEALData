[MASTER]
load-plugins=pylint_django
django-settings-module=dealdata_common.pylint_settings
ignore-paths=.*[\\/]migrations[\\/].*
init-hook=
    import os, sys; root = os.getcwd(); paths = [root, os.path.join(root, "core_layer"), os.path.join(root, "gps_layer"), os.path.join(root, "sensor_layer")]; [sys.path.insert(0, path) for path in paths if path not in sys.path]

[MESSAGES CONTROL]
disable=
    abstract-method,
    arguments-differ,
    access-member-before-definition,
    duplicate-code,
    invalid-name,
    line-too-long,
    missing-class-docstring,
    missing-function-docstring,
    missing-module-docstring,
    no-member,
    no-name-in-module,
    too-few-public-methods,
    unsubscriptable-object,
    wrong-import-position,
    too-many-arguments
