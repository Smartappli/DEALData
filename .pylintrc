[MASTER]
load-plugins=pylint_django
django-settings-module=dealdata_common.pylint_settings
init-hook=
    import sys; from pathlib import Path; root = Path.cwd(); [sys.path.insert(0, str(root / rel_path)) for rel_path in ("core_layer", "gps_layer", "sensor_layer") if str(root / rel_path) not in sys.path]
